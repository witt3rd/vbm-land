#!/usr/bin/env bash
# land-release [--area NAME] [--declare] [--rc] [--push]   (any repository, maintainer only; docs/pin.md section 2)
# Makes the release: the annotated, SIGNED tag v<VERSION> on HEAD. Its message records tree_sha256= (the tree hash of the exported HEAD, so the signature binds every file: land-pin vendor checks it),
# and, for a repository that ships a MANIFEST.sha256 (this tool's source), manifest_sha256= too (land-update, install). Consumers verify the signature against their own .land/land.signers first.
#   Requires: a clean tree, HEAD == origin/main (the release is what main is), a fresh MANIFEST.sha256 where the repository has one, the tag not yet existing, and a signing key:
#   LAND_SIGNING_KEY=<path to an ssh key; the public half is what .land/land.signers lists>. ssh signing, no gpg. Key custody and rotation are the maintainer's.
#   --push also pushes the tag (never a branch).
#   The release candidate: when the repository's land.conf (read from origin/main) sets LAND_RC_CMD, that command runs on the exact HEAD, with LAND_RC=1 in its environment, BEFORE any tag is made;
#   it must exit 0 or there is no tag. The command is the project's FULL suite: LAND_RC=1 tells it that nothing may be cached, selected or skipped (including LAND_INERT, which belongs to landing).
#   --declare cuts the candidate: the branch rc/v<VERSION> at origin/main's head, pushed. Main keeps landing at full speed; the full suite runs on the branch (--rc) and a red result is fixed with the
#   ordinary lander on the branch (LAND_BASE=rc/v<VERSION>) AND on main (the same fix, git cherry-pick -x), until green. A release made from the branch is refused while the branch holds a change that
#   is not on main (git cherry, which compares what a commit changes, not its hash). A release from main itself, with no branch, is still allowed.
#   --rc runs only that suite: no tag, no signing key, no VERSION or manifest check (HEAD must still be origin/main: the candidate is what main is). No LAND_RC_CMD: the release proceeds and says so on stderr.
#   --area NAME (the family repository, docs/family-repo.md sections 3 and 5): releases ONE library, lib/NAME/. The version is lib/NAME/VERSION, the tag NAME/vX.Y.Z (the candidate branch rc/NAME/vX.Y.Z), and the candidate runs every step of
#   area NAME AND of every area that depends on it (every area that lists lib/NAME/*), with LAND_RC=1; the other areas are named as not run, and LAND_RC_CMD is not run. Refused: a VERSION that is not greater (by number) than every
#   existing NAME/v* tag, a tag that exists, no "## X.Y.Z" heading in lib/NAME/CHANGELOG.md, a registry/NAME.json whose version differs, a red area. The message holds tree_sha256= of lib/NAME/ and one dep_tree_sha256=DEP:HASH per member
#   of its in-repo dependency closure (lib/*/deps); the new tag is verified against the signers file and removed when it does not verify. Without --area a repository that has registry/ refuses to tag (exit 2).
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd); . "$here/../lib/verify.sh"; . "$here/../lib/areas.sh"
root=$(git -C "$here" rev-parse --show-toplevel); cd "$root"
push=0; rc_only=0; declare=0; area=""; scratch=""; d=""; trap 'rm -rf "$scratch" "$d"' EXIT
usage() { echo "usage: land-release [--area NAME] [--declare] [--rc] [--push]" >&2; exit 2; }
while [ $# -gt 0 ]; do case $1 in --push) push=1;; --rc) rc_only=1;; --declare) declare=1;; --area) [ $# -ge 2 ] || usage; area=$2; shift;; *) usage;; esac; shift; done
[ -z "$area" ] || [[ "$area" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "land-release: '$area' is not a library name ([a-z0-9][a-z0-9_-]*)" >&2; exit 2; }
[ -n "$area" ] || [ "$rc_only" = 1 ] || [ "$declare" = 1 ] || ! git cat-file -e HEAD:registry 2>/dev/null || { echo "land-release: this repository has registry/: a tag of the whole repository has no meaning; release one library with --area NAME" >&2; exit 2; }   # [guard:registry]
vf=VERSION; [ -z "$area" ] || vf=lib/$area/VERSION
ver=$(cat "$vf" 2>/dev/null || true); tp=${area:+$area/}v
if [ "$rc_only" = 0 ] || [ "$declare" = 1 ]; then
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "land-release: $vf ($ver) is not a plain X.Y.Z" >&2; exit 2; }
  tag=$tp$ver
fi
if [ "$rc_only" = 0 ] && [ "$declare" = 0 ]; then
  key=${LAND_SIGNING_KEY:?set LAND_SIGNING_KEY to the ssh key that signs releases}
  [ -r "$key" ] || { echo "land-release: cannot read $key" >&2; exit 2; }
fi
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "land-release: the tree is not clean" >&2; exit 1; }
git fetch -q origin
cand=""; [ -z "$ver" ] || cand=rc/$tp$ver
has_cand() { [ -n "$cand" ] && git rev-parse -q --verify "refs/remotes/origin/$cand" >/dev/null; }
if [ "$declare" = 1 ]; then
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "land-release: HEAD is not origin/main: a candidate is cut from what main is" >&2; exit 1; }
  ! has_cand || { echo "land-release: $cand is already declared" >&2; exit 1; }
  git push -q origin "HEAD:refs/heads/$cand"
  echo "land-release: declared the candidate $cand at $(git rev-parse --short HEAD). Main keeps landing. Run the full suite on the branch (land-release --rc); fix a red result with LAND_BASE=$cand on the branch and the same fix on main (git cherry-pick -x); release from the branch (land-release --push) when green."
  exit 0
fi
base=main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  if has_cand && [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$cand")" ]; then base=$cand
  else echo "land-release: HEAD is neither origin/main nor the declared candidate origin/${cand:-rc/${tp}<VERSION>} (land-release --declare cuts one)" >&2; exit 1; fi
fi
if [ "$base" != main ]; then
  unported=$(git cherry origin/main HEAD | sed -n 's/^+ //p' | cut -c1-8 | tr '\n' ' ')
  [ -z "$unported" ] || { echo "land-release: the candidate $base holds changes that are not on main (git cherry): $unported: land the same fixes on main first" >&2; exit 1; }
fi
# ---- --area: what a release of ONE library must satisfy before its candidate runs (docs/family-repo.md section 3), all read from HEAD, which is what main (or the declared candidate) is
if [ -n "$area" ] && [ "$rc_only" = 0 ]; then
  scratch=$(mktemp -d); . "$here/../lib/subtree.sh"
  existing=$( { git tag -l "$area/v*"; git ls-remote --tags origin "refs/tags/$area/v*" | sed -e 's|^.*refs/tags/||' -e 's|\^{}$||'; } | sort -u )
  last=$(sed -n -E "s|^$area/v([0-9]+\.[0-9]+\.[0-9]+)\$|\1|p" <<<"$existing" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
  ! grep -qxF "$tag" <<<"$existing" || { echo "land-release: $tag already exists (tags are never moved): lib/$area/VERSION did not change since the last tag of $area" >&2; exit 1; }
  [ -z "$last" ] || [ "$(printf '%s\n%s\n' "$last" "$ver" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$ver" ] || { echo "land-release: lib/$area/VERSION ($ver) is not greater than the last tag $area/v$last (compared by number)" >&2; exit 1; }   # [guard:version]
  cl=$(git show "HEAD:lib/$area/CHANGELOG.md" 2>/dev/null || true)
  grep -qE "^## ${ver//./\\.}([^0-9]|\$)" <<<"$cl" || { echo "land-release: lib/$area/CHANGELOG.md has no heading line that begins '## $ver'" >&2; exit 1; }
  if git cat-file -e "HEAD:registry/$area.json" 2>/dev/null; then   # a mirror of the version, IF the repository keeps one, must agree; a repository that describes its libraries with cards derives the version from lib/NAME/VERSION and keeps no copy
    rv=$(git show "HEAD:registry/$area.json" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])' 2>/dev/null || true)
    [ "$rv" = "$ver" ] || { echo "land-release: registry/$area.json says version '$rv', lib/$area/VERSION says $ver" >&2; exit 1; }
  fi
  git show "origin/$base:$LAND_SIGNERS_FILE" > "$scratch/signers" 2>/dev/null || { echo "land-release: origin/$base has no $LAND_SIGNERS_FILE: a library tag is verified against it" >&2; exit 2; }
fi
# ---- the release candidate: the project's full suite on the exact HEAD, before anything is signed. The config is read from the branch being released (origin/main or the candidate; data, never expanded), like the lander reads it.
rcconf=$(git show "origin/$base:${LAND_CONF_FILE:-.land/land.conf}" 2>/dev/null || true)
rc_cmd=$(printf '%s\n' "$rcconf" | sed -n 's/^[[:space:]]*LAND_RC_CMD=//p' | tail -n 1)
rc_to=$(printf '%s\n' "$rcconf" | sed -n 's/^[[:space:]]*LAND_RC_TIMEOUT=//p' | tail -n 1); rc_to=${rc_to:-7200}
[[ "$rc_to" =~ ^[0-9]+$ ]] || { echo "land-release: LAND_RC_TIMEOUT ($rc_to) is not a whole number of seconds" >&2; exit 2; }
# areas (docs/areas.md rule 7): the candidate runs EVERY step of EVERY area, then LAND_RC_CMD (the extra checks areas do not carry)
has_areas=0; if git cat-file -e "origin/$base:$LAND_AREAS_FILE" 2>/dev/null; then
  has_areas=1; echo "land-release: release candidate $(git rev-parse --short HEAD): ${area:+the steps of area $area and of every area that depends on it}${area:-every step of every area} (LAND_RC=1)"
  rc=0; areas_candidate "$root" "origin/$base" "$rc_to" "$area" || rc=$?
  [ "$rc" != 2 ] || [ -z "$area" ] || exit 2
  [ "$rc" = 0 ] || { echo "land-release: the release candidate is RED in an area (exit $rc): no tag. Fix it on $base$([ "$base" = main ] || echo " and on main") and run this again." >&2; exit 1; }
elif [ -n "$area" ]; then echo "land-release: origin/$base has no $LAND_AREAS_FILE: --area needs the area of lib/$area" >&2; exit 2
fi
if [ -n "$area" ]; then
  echo "land-release: LAND_RC_CMD is not run with --area: it is the repository-wide candidate (land-release --rc without --area runs it); a library's own extra checks are steps of its area"
elif [ -n "$rc_cmd" ]; then
  echo "land-release: release candidate $(git rev-parse --short HEAD): running LAND_RC_CMD (LAND_RC=1: nothing may be cached, selected or skipped)"
  rc=0; LAND_RC=1 timeout --foreground "$rc_to" bash -c "$rc_cmd" || rc=$?
  [ "$rc" = 0 ] || { echo "land-release: the release candidate is RED (exit $rc): no tag. Fix it on $base$([ "$base" = main ] || echo " and on main") and run this again." >&2; exit 1; }
  echo "land-release: the release candidate is green"
elif [ "$has_areas" = 0 ]; then
  echo "land-release: no LAND_RC_CMD in ${LAND_CONF_FILE:-.land/land.conf}: this release candidate is NOT verified by a full suite" >&2
fi
[ "$rc_only" = 0 ] || exit 0
name=$(basename "$(git remote get-url origin)" .git); msgs=(-m "$name $tag")
if [ -z "$area" ] && [ -f MANIFEST.sha256 ]; then
  bin/land-manifest --check >/dev/null || { echo "land-release: MANIFEST.sha256 is stale" >&2; exit 1; }
  msgs+=(-m "manifest_sha256=$(sha256sum < MANIFEST.sha256 | cut -d' ' -f1)")
fi
! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "land-release: $tag already exists (tags are never moved)" >&2; exit 1; }
if [ -n "$area" ]; then   # the subtree form (docs/family-repo.md section 3): the tree hash of lib/NAME/ and of each member of its closure, in ONE paragraph of the message
  body="tree_sha256=$(st_hash_at . HEAD "lib/$area")" || exit 1; closure=$(st_closure_at . HEAD "$area") || exit 1
  for m in $closure; do h=$(st_hash_at . HEAD "lib/$m") || exit 1; body+=$'\n'"dep_tree_sha256=$m:$h"; done
  msgs=(-m "$name $tag
$body")
else
  d=$(mktemp -d); export_commit . HEAD "$d"
  th=$(tree_hash "$d" 2>&1) || { echo "land-release: the tree cannot be hashed: $th" >&2; exit 1; }
  msgs+=(-m "tree_sha256=$th")
fi
git -c gpg.format=ssh -c "user.signingkey=$key" tag -s "$tag" "${msgs[@]}"
if [ -n "$area" ]; then src_tag_signed . "$tag" "$scratch/signers" || { git tag -d "$tag" >/dev/null; echo "land-release: $tag is not signed by a key of $LAND_SIGNERS_FILE: the tag is removed, nothing was pushed" >&2; exit 1; }; fi   # [guard:signed]
echo "land-release: signed tag $tag on $(git rev-parse --short HEAD)"
if [ "$push" = 1 ]; then git push -q origin "refs/tags/$tag"; echo "land-release: pushed $tag"
  # The candidate branch has done its job once its commits are in the pushed tag: delete it, so a release leaves no branch behind. A candidate that holds a commit the tag does not (a fix not released) is KEPT, and said so.
  if has_cand; then
    if git merge-base --is-ancestor "origin/$cand" "refs/tags/$tag"; then git push -q origin ":refs/heads/$cand" && echo "land-release: deleted the candidate branch $cand (the tag $tag holds its commits)"
    else echo "land-release: kept the candidate branch $cand: it holds commits the tag $tag does not" >&2; fi
  fi
else echo "land-release: push it with: git push origin refs/tags/$tag"; fi
