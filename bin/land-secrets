#!/usr/bin/env bash
# land-secrets [--selftest] [--staged] [--config FILE] [--runner CMD]   (docs/secrets-gate.md)
# The secret gate: no secret in any repository's history or tree. The tool owns HOW the scanner is run (what is scanned, the exit codes, the negative self-test); the repository owns WHICH
# (its .gitleaks.toml and the allowlist in it, a reason beside every entry) and PINS the scanner itself (mise.toml: the tool never vendors or pins one). Run from anywhere inside the repository.
#   (default)   the WHOLE HISTORY (gitleaks git), then the WORKING TREE (gitleaks dir), both with --redact --no-banner --config FILE
#   --staged    only what is staged (gitleaks git --pre-commit --staged): for a pre-commit hook
#   --selftest  the negative self-test: a planted token-shaped string MUST be found and a clean file MUST NOT, by the repository's own config; prints `ran: secrets-selftest: 2 cases`
#   --config    the scanner's configuration (default .gitleaks.toml at the repository root); it must exist, the tool never scans with defaults silently
#   --runner    the command prefix that runs the scanner (for example `mise exec --`); else $LAND_SECRETS_RUNNER; else `mise exec --` when mise.toml exists and mise is on PATH; else the bare scanner
# Exit: 0 clean | 1 a secret was found (or, with --selftest, the gate is blind or cries wolf) | 2 the gate could not run (no scanner, no config, the scanner failed otherwise): FAIL CLOSED.
# A secret value is never printed: the scanner always runs with --redact.
set -euo pipefail
export LC_ALL=C
usage() { echo "usage: land-secrets [--selftest] [--staged] [--config FILE] [--runner CMD]" >&2; exit 2; }
selftest=0; staged=0; config=; runner_arg=; runner_set=0; start=$PWD
while [ $# -gt 0 ]; do
  case $1 in
    --selftest) selftest=1;;
    --staged) staged=1;;
    --config) [ $# -ge 2 ] || usage; config=$2; shift;;
    --runner) [ $# -ge 2 ] || usage; runner_arg=$2; runner_set=1; shift;;
    *) usage;;
  esac
  shift
done
[ "$selftest$staged" != 11 ] || usage
root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$root" ]; then
  [ "$selftest" = 1 ] || { echo "land-secrets: not inside a git repository: there is no history to scan (the gate could not run)" >&2; exit 2; }
  root=$PWD
fi
[ -n "$config" ] || config=$root/.gitleaks.toml
case $config in /*) ;; *) config=$start/$config;; esac
[ -f "$config" ] || { echo "land-secrets: no scanner configuration at $config: a repository that runs the gate must declare its own (.gitleaks.toml); the gate never scans with defaults (the gate could not run)" >&2; exit 2; }

# the runner: flag, then environment, then mise (the repository pins its scanner there), then the bare scanner
if [ "$runner_set" = 1 ]; then runner_str=$runner_arg
elif [ -n "${LAND_SECRETS_RUNNER:-}" ]; then runner_str=$LAND_SECRETS_RUNNER
elif [ -f "$root/mise.toml" ] && command -v mise >/dev/null 2>&1; then runner_str="mise exec --"
else runner_str=; fi
runner=(); [ -z "$runner_str" ] || read -r -a runner <<< "$runner_str"
if [ "${#runner[@]}" -gt 0 ]; then
  command -v "${runner[0]}" >/dev/null 2>&1 || { echo "land-secrets: the scanner runner '${runner[0]}' is not on PATH (the gate could not run)" >&2; exit 2; }
else
  command -v gitleaks >/dev/null 2>&1 || { echo "land-secrets: no scanner: gitleaks is not on PATH (pin it in mise.toml, or name a runner with --runner / LAND_SECRETS_RUNNER; the gate could not run)" >&2; exit 2; }
fi

out=$(mktemp "${TMPDIR:-/tmp}/land-secrets.XXXXXX"); work=
cleanup() { rm -rf "$out" ${work:+"$work"}; }; trap cleanup EXIT

# scan LABEL ARGS...: run the scanner with ARGS (always redacted); SCAN_RC is 0 clean, 1 a finding, 2 the scanner could not run. The scanner's output is in $out (redacted).
scan() {
  local label=$1 rc=0; shift
  cd "$root"
  ${runner[@]+"${runner[@]}"} gitleaks "$@" --redact --no-banner --config "$config" >"$out" 2>&1 || rc=$?
  case $rc in
    0) SCAN_RC=0;;
    1) # gitleaks exits 1 for a finding and for a fatal error alike: a fatal line, or the runner's own error, means it could not run
       if grep -Eq '^([^ ]+ )?FTL |^mise ERROR|: command not found$' "$out"; then SCAN_RC=2; else SCAN_RC=1; fi;;
    *) SCAN_RC=2;;
  esac
  if [ "$SCAN_RC" = 2 ]; then
    echo "land-secrets: $label: the scanner could not run (exit $rc): the gate fails closed" >&2; tail -n 20 "$out" >&2
  fi
}

if [ "$selftest" = 1 ]; then
  # The planted token is BUILT AT RUN TIME from two fragments and never written out whole: this repository is scanned by its own gate, and a literal planted secret
  # in the tool that scans for secrets would be found by it (the classic mistake). `ghp_` plus 36 alphanumerics is the shape of a GitHub personal access token.
  a=Zk3Qm9Xt1Lw7Rb5Vc0; b=Hn2Ys8Dj4Fg6Pa7Ue1
  tok="ghp_${a}${b}"
  work=$(mktemp -d "${TMPDIR:-/tmp}/land-secrets-self.XXXXXX"); mkdir "$work/planted" "$work/clean"
  printf 'github_token = "%s"\n' "$tok" > "$work/planted/leak.txt"
  printf 'nothing secret here: a sentence about tokens and a number, 42\n' > "$work/clean/ok.txt"
  scan "selftest (planted file)" dir "$work/planted"; [ "$SCAN_RC" != 2 ] || exit 2
  [ "$SCAN_RC" = 1 ] || { echo "land-secrets: selftest FAILED: the planted token was not found with $config: the gate is blind" >&2; exit 1; }
  scan "selftest (clean file)" dir "$work/clean"; [ "$SCAN_RC" != 2 ] || exit 2
  [ "$SCAN_RC" = 0 ] || { echo "land-secrets: selftest FAILED: the clean file was reported with $config: the gate cannot be trusted" >&2; exit 1; }
  echo "land-secrets: selftest ok: the planted token was found, the clean file passed"
  echo "ran: secrets-selftest: 2 cases"
  exit 0
fi

found=0; fatal=0
report() { echo "land-secrets: $1: a secret was found" >&2; tail -n 30 "$out" >&2; found=1; }
if [ "$staged" = 1 ]; then
  scan "staged changes" git --pre-commit --staged .
  case $SCAN_RC in 1) report "staged changes";; 2) fatal=1;; esac
else
  scan "history" git .
  case $SCAN_RC in 1) report "history";; 2) fatal=1;; esac
  if [ "$fatal" = 0 ]; then scan "working tree" dir .; case $SCAN_RC in 1) report "working tree";; 2) fatal=1;; esac; fi
fi
if [ "$found" = 1 ]; then echo "a secret is in the history or the tree: rotate it first, then remove it; never allowlist a real one" >&2; exit 1; fi
[ "$fatal" = 0 ] || exit 2
echo "land-secrets: ok: no secret found"
