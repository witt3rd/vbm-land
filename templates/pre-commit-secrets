#!/usr/bin/env bash
# The secret gate's pre-commit hook (docs/secrets-gate.md). A repository copies this file to .githooks/pre-commit, makes it executable and sets
#   git config core.hooksPath .githooks        (once per clone)
# It is the EARLY warning and a per-clone opt-in; the gate in Tier 1 is the one that cannot be skipped.
# It fails CLOSED: whatever stops the scanner from running (no scanner, no .land/tool, no repository) refuses the commit.
set -uo pipefail
top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" || { echo "pre-commit: cannot find the repository top level; the secret gate did not run." >&2; echo "Nothing was committed. Secrets live in your secret manager, never in a repository." >&2; exit 1; }
if ! .land/tool/bin/land-secrets --staged; then
  echo "" >&2
  echo "Nothing was committed. Secrets live in your secret manager, never in a repository." >&2
  exit 1
fi
