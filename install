#!/usr/bin/env bash
# install [--source SRC] [--target DIR] <tag|commit>
#
# Vendors a PINNED copy of vbm-land into a repository: the tool (read-only by contract, replaced whole on every install) with its MANIFEST.sha256 inside the tool folder, the PIN and the repository's own
# files (settings, hooks, signers, entry script) in the folder that holds it, and the agent skills in .agents/skills/. The entry script (three lines that exec the tool beside it, so "land with the entry
# script" stays true) and a starter settings file exist only on the FIRST install and only when absent (they are yours afterwards: an update never brings back a file the repository removed). Every path it writes is defined once, in lib/paths.sh. It commits nothing: review the diff and commit it as one change
# (`chore(land): vbm-land <version>`). Re-running it with another ref is the update.
#
#   SRC     where the source repository is: OWNER/NAME (GitHub, through `gh`, so a private repository works), or anything git can clone (URL, path).
#           Default: $VBM_LAND_SOURCE.
#   ref     a tag or a commit. The pin records the 40-hex COMMIT (a tag can move, a commit cannot) and the hash of the release's manifest.
#   --target DIR   the repository to install into (default: the current repository's root).
#   --signers FILE an ssh allowed-signers file (the maintainer's public key, taken from a source you trust, out of band): copied to the repository's signers file when absent. With a signers file the
#                  release MUST be a signed tag from an allowed signer that records the manifest it points at, or nothing is written; without one the install says UNVERIFIED.
#
# MIGRATION (the old layout, before 0.8.0). A consumer that still keeps the tool in $LAND_LEGACY_DIR (its PIN there, and no $LAND_PIN yet) is migrated by the same install that writes the new layout: once the
# new tool, PIN and skills are in place, the repository's OWN files are MOVED, never rewritten ($LAND_LEGACY_CONF_FILE, $LAND_LEGACY_SIGNERS_FILE, $LAND_LEGACY_HOOKS_DEFAULT and $LAND_LEGACY_ENTRY to their
# $LAND_HOME names), and then the old $LAND_LEGACY_DIR tree is removed. The entry script keeps its content but for the one path in its exec line: `/land/bin/land-direct` becomes `/tool/bin/land-direct`, because
# the tool now sits in ./tool beside it (an exec naming the old folder from the repository root becomes the $LAND_DIR one). Nothing of the repository's own is overwritten or lost: if a destination already
# exists the install STOPS, names it, and writes nothing (the whole migration is refused, before any file is written). Every path above is defined once, in lib/paths.sh. What the repository's own scripts, docs
# and Tier 1 still call by the old names is printed as information only: the migration never edits a file of the repository's own beyond those moves.

# One command, from the target repository:
#   gh api repos/OWNER/vbm-land/contents/install?ref=<tag> -H 'Accept: application/vnd.github.raw' | bash -s -- --source OWNER/vbm-land <tag>
# or, with a checkout of the source:  /path/to/vbm-land/install --source /path/to/vbm-land <tag>
# Nothing is fetched or run at landing time: the vendored tree is committed, so a worktree is self-contained and offline.
set -euo pipefail
export LC_ALL=C
src=${VBM_LAND_SOURCE:-}; target=; ref=; signers_arg=
while [ $# -gt 0 ]; do case $1 in
  --source) src=${2:?--source needs a value}; shift;; --target) target=${2:?--target needs a directory}; shift;; --signers) signers_arg=${2:?--signers needs a file}; shift;;
  -h|--help) sed -n '2,27p' "$0" 2>/dev/null | sed 's/^# \{0,1\}//'; exit 0;;
  -*) echo "usage: install [--source SRC] [--target DIR] <tag|commit>" >&2; exit 2;; *) ref=$1;; esac; shift; done
[ -n "$src" ] && [ -n "$ref" ] || { echo "usage: install [--source SRC] [--target DIR] <tag|commit>   (SRC: OWNER/NAME or a git URL or path)" >&2; exit 2; }
[ -n "$target" ] || target=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "install: not inside a git repository (use --target DIR)" >&2; exit 2; }
target=$(cd "$target" && pwd); git -C "$target" rev-parse --git-dir >/dev/null 2>&1 || { echo "install: $target is not a git repository" >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/vbm-land-install.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
if [[ "$src" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && [ ! -e "$src" ]; then
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true timeout 120 git -c credential.helper= clone -q --bare -- "${VBM_LAND_URL_BASE:-https://github.com}/$src.git" "$tmp/src" >/dev/null 2>&1 || { rm -rf "$tmp/src"   # anonymous https first (a public source needs no token), then gh (a private one)
    "${GH:-gh}" repo clone "$src" "$tmp/src" -- --quiet --bare >/dev/null 2>&1 || { echo "install: cannot clone $src (anonymously over https, nor with gh)" >&2; exit 1; }; }
else git clone -q --bare -- "$src" "$tmp/src" >/dev/null 2>&1 || { echo "install: cannot clone $src" >&2; exit 1; }; fi
commit=$(git -C "$tmp/src" rev-parse --verify -q "$ref^{commit}") || { echo "install: $src has no tag or commit '$ref'" >&2; exit 1; }
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "install: unexpected commit id for $ref" >&2; exit 1; }
git -C "$tmp/src" show "$commit:lib/paths.sh" > "$tmp/paths.sh" || { echo "install: $ref has no lib/paths.sh: not a release of this tool" >&2; exit 1; }   # the release defines the paths it writes: read them from it, before anything is written
. "$tmp/paths.sh"
signers=; if [ -n "$signers_arg" ]; then signers=$signers_arg; elif [ -r "$target/$LAND_SIGNERS_FILE" ]; then signers=$target/$LAND_SIGNERS_FILE; elif [ -r "$target/$LAND_LEGACY_SIGNERS_FILE" ]; then signers=$target/$LAND_LEGACY_SIGNERS_FILE; fi   # a consumer still in the old layout keeps its signers file at the old path: it makes the signature mandatory all the same (the migration moves it)
# VERIFIER BEGIN (lib/verify.sh, verbatim: the installer of a first install is self-contained; tests/test_verifier_one.sh checks the copy)
# lib/verify.sh: the ONE verifier of this tool (docs/pin.md, docs/payload.md 6a): the tree hash and the check of a signed release tag. Sourced, never run.
# `install` embeds this file verbatim (it must run without a checkout); tests/test_verifier_one.sh fails when the copy differs.
# The tree hash of docs/pin.md section 1, defined ONCE.
# tree_hash DIR: print the SHA-256 of the sorted lines "<sha256 of the file> <path relative to DIR>" of every file under DIR except what is under .lake or .git.
# Returns 1, with the reason on stderr, for a missing DIR, a symlink or other non-regular file, or a path outside [A-Za-z0-9._+/-] (never a silently different hash).
tree_hash() (
  set -euo pipefail; export LC_ALL=C
  [ -d "${1:-}" ] || { echo "treehash: ${1:-} is not a directory" >&2; exit 1; }
  cd "$1"; files=()
  while IFS= read -r -d '' p; do
    [[ $p =~ ^\./[A-Za-z0-9._+/-]+$ ]] || { echo "treehash: $1: unsafe path ${p@Q}" >&2; exit 1; }
    { [ -f "$p" ] && [ ! -L "$p" ]; } || { echo "treehash: $1/${p#./} is not a regular file" >&2; exit 1; }
    files+=("$p")
  done < <(find . \( -path ./.lake -o -path ./.git \) -prune -o ! -type d -print0)
  if [ ${#files[@]} = 0 ]; then printf '' | sha256sum | cut -d' ' -f1; exit 0; fi
  printf '%s\0' "${files[@]}" | xargs -0 sha256sum -- | sed -E 's/^([0-9a-f]{64})  \.\//\1 /' | sort | sha256sum | cut -d' ' -f1
)

# export_commit REPO REV DEST: the exported tree of REV in REPO (git archive) into the existing directory DEST. The tree hash of a commit is tree_hash of this export (docs/pin.md section 1).
export_commit() { git -C "$1" archive --format=tar "$2" | tar -x -C "$3"; }

# src_check_tag DEST REF SIGNERS [OUTDIR]: strict. DEST is a git repository (bare or not) holding the tag. Succeeds, printing the verified tree hash, only when REF is an annotated tag signed by an allowed
# signer of SIGNERS, its message records exactly one tree_sha256=, and the exported tree of the tagged commit (into OUTDIR when given, so the caller keeps it) hashes to it. Otherwise returns 1, the reason on stderr.
src_check_tag() {
  local dest=$1 ref=$2 signers=${3:-} out=${4:-} kind want got d
  { [ -n "$signers" ] && [ -r "$signers" ]; } || { echo "REFUSED: no readable signers file: a release signature cannot be checked" >&2; return 1; }
  kind=$(git -C "$dest" cat-file -t "refs/tags/$ref" 2>/dev/null) || { echo "REFUSED: $ref is not a release tag, and signed releases are required; pass the tag, not a commit" >&2; return 1; }
  [ "$kind" = tag ] || { echo "REFUSED: $ref is a lightweight tag: a signed, annotated release tag is required" >&2; return 1; }
  git -C "$dest" -c gpg.format=ssh -c "gpg.ssh.allowedSignersFile=$signers" verify-tag "$ref" >/dev/null 2>&1 || { echo "REFUSED: the signature of tag $ref does not verify against $signers (unsigned, or an unknown signer)" >&2; return 1; }
  want=$(git -C "$dest" tag -l --format='%(contents)' "$ref" | sed -n -E 's/^tree_sha256=([0-9a-f]{64})$/\1/p')
  [ "$(printf '%s\n' "$want" | grep -c .)" = 1 ] || { echo "REFUSED: the message of $ref does not record exactly one tree_sha256=" >&2; return 1; }
  d=${out:-$(mktemp -d)}; export_commit "$dest" "$ref^{commit}" "$d"
  got=$(tree_hash "$d" 2>&1) || { [ -n "$out" ] || rm -rf "$d"; echo "REFUSED: the exported tree of $ref cannot be hashed: $got" >&2; return 1; }
  [ -n "$out" ] || rm -rf "$d"
  [ "$got" = "$want" ] || { echo "REFUSED: tag $ref records tree_sha256=$want, but its exported tree hashes to $got" >&2; return 1; }
  printf '%s\n' "$got"
}

# src_verify DEST REF SIGNERS: the rule of land-update and install. No signers file = an unsigned first install or a pin by commit: allowed, said so (returns 10). A signers file makes the signed tag mandatory (returns 1 when refused).
src_verify() {
  local dest=$1 ref=$2 signers=${3:-}
  if [ -z "$signers" ]; then echo "UNVERIFIED: no signers file ($LAND_SIGNERS_FILE): the release signature was not checked"; return 10; fi
  src_check_tag "$dest" "$ref" "$signers" >/dev/null || return 1
  echo "verified: tag $ref is signed by an allowed signer and records this tree"; return 0
}
# VERIFIER END
vrc=0; vmsg=$(src_verify "$tmp/src" "$ref" "$signers") || vrc=$?
[ "$vrc" != 1 ] || exit 1
git -C "$tmp/src" show "$commit:MANIFEST.sha256" > "$tmp/MANIFEST.sha256" 2>/dev/null || { echo "install: $ref has no MANIFEST.sha256: not a release of this tool" >&2; exit 1; }
mkdir -p "$tmp/tree"; git -C "$tmp/src" archive "$commit" | tar -x -C "$tmp/tree"
# verify what was fetched against the manifest at that same commit before touching the target
while read -r h f; do
  [ -f "$tmp/tree/$f" ] && [ "$(sha256sum < "$tmp/tree/$f" | cut -d' ' -f1)" = "$h" ] || { echo "install: $f at $ref does not match its manifest entry: refusing" >&2; exit 1; }
done < "$tmp/MANIFEST.sha256"
version=v$(cat "$tmp/tree/VERSION")
# vpath is land_vpath: the release's own lib/paths.sh, sourced above, defines every path this tool writes
# The OLD layout (before 0.8.0): the tool in $LAND_LEGACY_DIR with its own PIN there, and no $LAND_PIN yet. Then this install migrates the repository (below, after the new tool, PIN and skills are written).
migrate=0; [ ! -e "$target/$LAND_LEGACY_PIN" ] || [ -e "$target/$LAND_PIN" ] || migrate=1
if [ "$migrate" = 1 ]; then   # the whole migration is refused HERE, before anything at all is written: a destination that already exists would be overwritten, or the repository's own file lost
  clash=
  for pair in "$LAND_LEGACY_CONF_FILE:$LAND_CONF_FILE" "$LAND_LEGACY_SIGNERS_FILE:$LAND_SIGNERS_FILE" "$LAND_LEGACY_HOOKS_DEFAULT:$LAND_HOOKS_DEFAULT" "$LAND_LEGACY_ENTRY:$LAND_ENTRY"; do
    o=${pair%%:*}; n=${pair#*:}; [ -e "$target/$o" ] || continue
    [ ! -e "$target/$n" ] || clash="$clash $n"
  done
  [ -z "$clash" ] || { echo "install: REFUSED: this repository is still in the old layout ($LAND_LEGACY_DIR) and migrating it would put the repository's own files onto ones that already exist:$clash" >&2
    echo "install: move or remove those, then run the install again. Nothing was written: no $LAND_DIR, no $LAND_PIN, no skill." >&2; exit 1; }
fi
[ ! -r "$target/$LAND_MANIFEST_FILE" ] || while read -r _ f; do case $f in skills/*) rm -f "$target/$(land_vpath "$f")";; esac; done < "$target/$LAND_MANIFEST_FILE"   # skills the new release dropped
first=0; [ -e "$target/$LAND_PIN" ] || first=1   # the repository's own files are created by the FIRST install only
rm -rf "$target/$LAND_DIR"; mkdir -p "$target/$LAND_DIR"   # the tool folder is replaced whole: a file the release dropped disappears
# land_vpath (lib/paths.sh, above): where a path of the release payload goes in the target
while read -r h f; do
  [ -n "$f" ] || continue; v=$(land_vpath "$f"); mkdir -p "$target/$(dirname "$v")"; cp "$tmp/tree/$f" "$target/$v"
  case $f in bin/*) chmod +x "$target/$v";; *) chmod -x "$target/$v";; esac
done < "$tmp/MANIFEST.sha256"
cp "$tmp/MANIFEST.sha256" "$target/$LAND_MANIFEST_FILE"
mkdir -p "$(dirname "$target/$LAND_PIN")"   # the pin lives beside the tool folder, never inside it: replacing the folder must not remove it
printf 'source=%s\nversion=%s\ncommit=%s\nmanifest_sha256=%s\nsignature=%s\n' "$src" "$version" "$commit" "$(sha256sum < "$tmp/MANIFEST.sha256" | cut -d' ' -f1)" "$([ "$vrc" = 0 ] && echo verified || echo unverified)" > "$target/$LAND_PIN"
if [ "$migrate" = 1 ]; then   # the old layout: MOVE the repository's own files into $LAND_HOME (their content is kept; only the entry script's one exec path is rewritten), then remove the old tool folder
  mkdir -p "$target/$LAND_HOME"; moved=
  for pair in "$LAND_LEGACY_CONF_FILE:$LAND_CONF_FILE" "$LAND_LEGACY_SIGNERS_FILE:$LAND_SIGNERS_FILE" "$LAND_LEGACY_HOOKS_DEFAULT:$LAND_HOOKS_DEFAULT"; do
    o=${pair%%:*}; n=${pair#*:}; [ -e "$target/$o" ] || continue; mv "$target/$o" "$target/$n"; moved="$moved $o -> $n"
  done
  if [ -e "$target/$LAND_LEGACY_ENTRY" ]; then   # the entry script is the repository's own: same content, but the tool now sits in ./tool beside it
    mv "$target/$LAND_LEGACY_ENTRY" "$target/$LAND_ENTRY"; moved="$moved $LAND_LEGACY_ENTRY -> $LAND_ENTRY"
    legacy_pat=$(printf '%s' "$LAND_LEGACY_DIR" | sed 's/\./\\./g')   # the old tool folder, as the entry script may spell it from the repository root
    sed -i -e "s|$legacy_pat/bin/land-direct|$LAND_DIR/bin/land-direct|g" -e 's|/land/bin/land-direct|/tool/bin/land-direct|g' "$target/$LAND_ENTRY"   # beside itself (the stub's form) or from the root: the tool now sits in ./tool
    chmod +x "$target/$LAND_ENTRY"
  fi
  # a tracked SYMLINK of the repository's own can point into the old tool folder (vbm-sse tracks scripts/lib-no-crash-record.sh -> land/lib/no-crash-record.sh, relative to the link's own directory).
  # Removing the old tool folder would leave it dangling, so each such link is repointed, BEFORE the removal, to the same sub-path under $LAND_DIR, written relative to the link's own directory.
  # A relative path is computed in plain shell (no realpath, no GNU-only option): a link that points anywhere else is left alone.
  relpath() {   # relpath FROMDIR TODIR: TO target expressed relative to FROM, both absolute and normalized (no ".." left in FROM)
    local from=$1 to=$2 out= f t
    local IFS=/
    set -f; f=($from); t=($to); set +f
    local n=${#f[@]} i=0; [ "$n" -le "${#t[@]}" ] || { echo "$to"; return; }
    while [ "$i" -lt "$n" ] && [ "$i" -lt "${#t[@]}" ] && [ "${f[$i]}" = "${t[$i]}" ]; do i=$((i+1)); done
    local j=$i; while [ "$j" -lt "$n" ]; do out="../$out"; j=$((j+1)); done
    j=$i; while [ "$j" -lt "${#t[@]}" ]; do out="$out${t[$j]}/"; j=$((j+1)); done
    out=${out%/}; echo "${out:-.}"
  }
  links=
  tdir=$(cd "$target" && pwd -P)   # absolute, so a resolved link path can be compared with it
  while read -r l; do   # a tracked symlink (mode 120000) of the repository's own: its target as recorded
    [ -L "$target/$l" ] || continue
    tgt=$(git -C "$target" cat-file blob ":$l" 2>/dev/null) || continue
    case $tgt in /*) res=$tgt;; *) res=/$(dirname "$l")/$tgt;; esac   # resolved against the link's own directory
    res=$(cd "$tdir$(dirname "$res")" 2>/dev/null && pwd -P)/$(basename "$res") || continue   # absolute and normalized (pwd -P)
    case $res in "$tdir/$LAND_LEGACY_DIR"/*|"$tdir/$LAND_LEGACY_DIR") ;; *) continue;; esac   # points anywhere else: left alone
    sub=${res#"$tdir/$LAND_LEGACY_DIR"}; [ -n "$sub" ] || continue
    newtgt=$(relpath "$tdir/$(dirname "$l")" "$tdir/$LAND_DIR$sub")
    rm -f "$target/$l"; ln -s "$newtgt" "$target/$l"; links="$links $l -> $newtgt"
  done < <(git -C "$target" ls-files -s 2>/dev/null | awk '$1 == "120000" { print $4 }')   # the tracked symlinks; awk, not read: the stage field is TAB-separated
  rm -rf "$target/$LAND_LEGACY_DIR"
  [ -n "$moved" ] || moved=" nothing of its own files"
  [ -z "$links" ] || moved="$moved; repointed$links"
  echo "install: migrated the old layout: moved$moved; removed $LAND_LEGACY_DIR; the entry script now runs the tool in ./tool beside it."
  echo "install: INFORMATION ONLY (nothing was edited for you): the repository's own scripts, docs and Tier 1 must be updated from the old names to the new ones (lib/paths.sh: $LAND_DIR, $LAND_PIN, $LAND_CONF_FILE, $LAND_SIGNERS_FILE, $LAND_HOOKS_DEFAULT, $LAND_ENTRY)."
  # the old names are $LAND_LEGACY_DIR and its siblings in $LAND_LEGACY_HOME (lib/paths.sh, sourced above), so the pattern is built from them, not typed again
  oldpat="$(printf '%s' "$LAND_LEGACY_DIR" | sed 's/\./\\./g')([/.-]|$)"
  refs=$(git -C "$target" grep -n -E "$oldpat" -- . ":(exclude)$LAND_HOME" ":(exclude)$LAND_SKILLS_DIR" 2>/dev/null || true)   # the repository's own tracked files (its own scripts/ included: the old tool tree is already gone)
  if [ -n "$refs" ]; then echo "install: $(printf '%s\n' "$refs" | wc -l) reference(s) to the old paths are left in the repository's own tracked files, outside $LAND_HOME/ and $LAND_SKILLS_DIR/ (first 20):"; printf '%s\n' "$refs" | sed -n '1,20p' | sed 's/^/    /'
  else echo "install: no reference to the old paths is left in the repository's own tracked files, outside $LAND_HOME/ and $LAND_SKILLS_DIR/."; fi
fi
[ -z "$signers_arg" ] || [ -e "$target/$LAND_SIGNERS_FILE" ] || cp "$signers_arg" "$target/$LAND_SIGNERS_FILE"
created=
if [ "$first" = 1 ] && [ ! -e "$target/$LAND_ENTRY" ]; then cp "$tmp/tree/templates/land-direct-stub" "$target/$LAND_ENTRY"; chmod +x "$target/$LAND_ENTRY"; created="$created and the entry script $LAND_ENTRY"; fi
if [ "$first" = 1 ] && [ ! -e "$target/$LAND_CONF_FILE" ]; then cp "$tmp/tree/templates/land.conf.example" "$target/$LAND_CONF_FILE"; created="$created and a starter $LAND_CONF_FILE (edit it: at least LAND_TEST_CMD or LAND_GATES_CMD)"; fi
"$target/$LAND_DIR/bin/land-check" --root "$target" >/dev/null || { echo "install: the installed copy fails its own drift check" >&2; exit 1; }
echo "install: $vmsg"
echo "install: vbm-land $version ($commit) vendored into $target/$LAND_DIR$created."
echo "install: review and commit it as one change: chore(land): vbm-land $version. Agent-instructions block: templates/AGENTS-block.md in the source."
